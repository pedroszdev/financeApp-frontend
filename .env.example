# Alvo do proxy do Vite dev server. O frontend chama /api/... e o Vite
# encaminha para este alvo, contornando o CORS ausente na API.
#
# A API precisa estar rodando — não há instância pública no ar.
# Veja: https://github.com/pedroszdev/Sistema-financero-js
VITE_API_TARGET=http://localhost:3000

# Caminho base das chamadas HTTP do frontend. Mantenha "/api" em dev
# (casa com o proxy). Em produção, aponte para a URL absoluta da API
# (após configurar CORS no backend).
VITE_API_BASE_URL=/api
