# Alvo do proxy no dev server do Vite. Em dev, o frontend chama /api/... e o
# Vite encaminha para este alvo, contornando o CORS ausente na API.
VITE_API_TARGET=https://sistema-financero-js.onrender.com

# Caminho base das chamadas HTTP do frontend. Mantenha "/api" em dev (casa
# com o proxy). Em produção, aponte para a URL absoluta da API caso o CORS
# esteja configurado no backend.
VITE_API_BASE_URL=/api
